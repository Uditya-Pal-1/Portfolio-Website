# Server port (platforms like Railway/Render inject PORT automatically)
PORT=3000

# Comma-separated allowed origins for the contact API (your deployed frontend URL)
# Example: CORS_ORIGIN=https://your-domain.com,https://www.your-domain.com
CORS_ORIGIN=

# --- Optional: email notifications for contact form (Nodemailer + SMTP) ---
# Either SMTP_* (Gmail/any provider) or MAILTRAP_* vars work.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=you@gmail.com,
#        SMTP_PASS=<16-char App Password from myaccount.google.com/apppasswords>
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Mailtrap alternative:
# MAILTRAP_HOST=sandbox.smtp.mailtrap.io
# MAILTRAP_PORT=465
# MAILTRAP_USERNAME=
# MAILTRAP_PASSWORD=
# MAILTRAP_SENDEREMAIL=you@example.com

CONTACT_TO=amanpal5035286@gmail.com
